{
  "$defs": {
    "DatasetAsset": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "DatasetAsset",
      "type": "object"
    },
    "MeshCoordinates": {
      "additionalProperties": false,
      "properties": {
        "source_frame": {
          "const": "LOCAL_ENU_METRES",
          "default": "LOCAL_ENU_METRES",
          "title": "Source Frame",
          "type": "string"
        },
        "units": {
          "const": "metre",
          "default": "metre",
          "title": "Units",
          "type": "string"
        },
        "axis_convention": {
          "default": [
            "east",
            "north",
            "up"
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": "east",
              "type": "string"
            },
            {
              "const": "north",
              "type": "string"
            },
            {
              "const": "up",
              "type": "string"
            }
          ],
          "title": "Axis Convention",
          "type": "array"
        },
        "alignment_verified": {
          "const": true,
          "title": "Alignment Verified",
          "type": "boolean"
        },
        "altitude_reference": {
          "minLength": 1,
          "title": "Altitude Reference",
          "type": "string"
        },
        "alignment_evidence": {
          "$ref": "#/$defs/DatasetAsset"
        }
      },
      "required": [
        "alignment_verified",
        "altitude_reference",
        "alignment_evidence"
      ],
      "title": "MeshCoordinates",
      "type": "object"
    },
    "MeshSource": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/DatasetAsset"
        },
        "coordinates": {
          "$ref": "#/$defs/MeshCoordinates"
        },
        "geometry_source": {
          "const": "OBSERVED_RECONSTRUCTION",
          "default": "OBSERVED_RECONSTRUCTION",
          "title": "Geometry Source",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "artifact",
        "coordinates"
      ],
      "title": "MeshSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_status": {
      "const": "PROPOSED_NOT_INTEGRATED",
      "default": "PROPOSED_NOT_INTEGRATED",
      "title": "Contract Status",
      "type": "string"
    },
    "status": {
      "enum": [
        "UNAVAILABLE",
        "COMPLETED"
      ],
      "title": "Status",
      "type": "string"
    },
    "domain": {
      "default": "CENTROIDS_OF_DECLARED_OBSERVED_MESH_FACES",
      "title": "Domain",
      "type": "string"
    },
    "method": {
      "default": "RECTIFIED_CAMERA_Z_DEPTH_CONSISTENCY",
      "title": "Method",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/MeshSource"
        },
        {
          "type": "null"
        }
      ]
    },
    "available_support_statistics": {
      "additionalProperties": true,
      "title": "Available Support Statistics",
      "type": "object"
    },
    "views": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Views",
      "type": "array"
    },
    "additional_frame_proposals": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Additional Frame Proposals",
      "type": "array"
    },
    "observed_surface_area_m2": {
      "default": null,
      "title": "Observed Surface Area M2",
      "type": "null"
    },
    "reference_surface_area_m2": {
      "default": null,
      "title": "Reference Surface Area M2",
      "type": "null"
    },
    "observed_surface_completeness_percent": {
      "default": null,
      "title": "Observed Surface Completeness Percent",
      "type": "null"
    },
    "denominator": {
      "default": null,
      "title": "Denominator",
      "type": "null"
    },
    "unavailable_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Unavailable Reasons",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "status",
    "source"
  ],
  "title": "CoverageReport",
  "type": "object"
}
